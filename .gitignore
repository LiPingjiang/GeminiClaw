# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.js.map

# User configuration (never commit these)
config.yaml
config.local.yaml
config.*.yaml
!config.example.yaml
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets/

# Runtime data
data/
.data/
logs/
*.log
sessions/
