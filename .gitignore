# Runtime memory dumps would live under .data/ instead

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/

# Git worktrees
.worktrees/

# Private workspace (personal memory, user data, API keys)
.workspace/
